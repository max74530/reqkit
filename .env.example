# ReqKit 環境變數範例
# 複製成 .env 後依實際需求修改（.env 已被 gitignore，不會提交）
#
#   cp .env.example .env
#
# 本專案不強制讀取 .env，請自行匯出為環境變數：
#   Linux/macOS:  export REQKIT_ADMIN_PASSWORD='...'
#   PowerShell :  $env:REQKIT_ADMIN_PASSWORD = '...'

# ── 必要 ────────────────────────────────────────────────
# 管理員密碼，首次啟動必填，至少 4 碼。
# ⚠️ 請務必改成你自己的密碼，勿使用範例值。
REQKIT_ADMIN_PASSWORD=change_this_password

# ── 選用 ────────────────────────────────────────────────
# 管理員帳號與顯示名稱
# REQKIT_ADMIN_USER=admin
# REQKIT_ADMIN_NAME=Admin

# 資料根目錄（預設 ./data）
# REQKIT_DATA_DIR=/var/lib/reqkit

# SQLite 檔案目錄（預設跟隨 REQKIT_DATA_DIR）
# REQKIT_DB_DIR=/var/lib/reqkit

# 年度封存與備份檔目錄（預設 <data>/archive）
# REQKIT_ARCHIVE_DIR=/var/lib/reqkit/archive

# Token 簽章金鑰；未設定時自動產生並保存於 data/.secret_key
# 若設定此項，請確保長度足夠且不外流。
# REQKIT_SECRET_KEY=

# 登入有效時數（預設 12）
# REQKIT_TOKEN_HOURS=12

# 服務埠號（預設 2000）
# PORT=2000